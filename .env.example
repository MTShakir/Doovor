# Copy to .env.local at the repository root. The web app, scripts and the Supabase CLI all
# read that one file. Never commit real values. Use test or sandbox keys outside production.
# Variables starting NEXT_PUBLIC_ are sent to browsers: never put a secret in one.

# ---------------------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------------------
# local | test | preview | production. Production refuses fake providers.
APP_ENV=local
# Base URL of this environment. Leave empty on Vercel previews to use the deployment URL.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------------------
# Supabase (London). Local values come from `pnpm db:start` (run `pnpm supabase status`).
# Publishable and secret keys replace the legacy anon and service_role keys (D-006).
# ---------------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Publishable key (formerly the anon key). Safe in browsers; RLS protects the data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (formerly service_role). Server only: Stripe webhooks, jobs and seed scripts.
SUPABASE_SECRET_KEY=

# ---------------------------------------------------------------------------------------
# Sign-in providers (AUTH-01). Buttons stay hidden unless enabled here.
# ---------------------------------------------------------------------------------------
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=false
NEXT_PUBLIC_AUTH_APPLE_ENABLED=false
# Read by supabase/config.toml for local Google sign-in. Hosted projects set these in the
# Supabase dashboard (Authentication > Providers) instead.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# ---------------------------------------------------------------------------------------
# Payments: Stripe Connect Express (PAY-01). "fake" needs no keys.
# ---------------------------------------------------------------------------------------
PAYMENTS_PROVIDER=fake
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# Signing secret for platform account events.
STRIPE_WEBHOOK_SECRET=
# Signing secret for connected account events (direct charges, D-011).
STRIPE_CONNECT_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------------------
# Email: Resend with React Email templates. "log" writes emails to the console.
# ---------------------------------------------------------------------------------------
EMAIL_PROVIDER=log
RESEND_API_KEY=

# ---------------------------------------------------------------------------------------
# SMS: Twilio (reminders on Pro, NTF-01). "log" writes messages to the console.
# Sender ID comes from brand.ts; the messaging service must allow it.
# ---------------------------------------------------------------------------------------
SMS_PROVIDER=log
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=

# ---------------------------------------------------------------------------------------
# Maps: Mapbox public token, restricted to this app's URLs (COV-01).
# ---------------------------------------------------------------------------------------
NEXT_PUBLIC_MAPBOX_TOKEN=

# ---------------------------------------------------------------------------------------
# Web push (VAPID). Generate with `pnpm dlx web-push generate-vapid-keys`.
# VAPID_SUBJECT defaults to the support email in brand.ts.
# ---------------------------------------------------------------------------------------
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# ---------------------------------------------------------------------------------------
# Background jobs: Inngest. Not needed locally (the dev server runs without keys).
# ---------------------------------------------------------------------------------------
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ---------------------------------------------------------------------------------------
# Field encryption (NFR-SEC-04, D-010). Comma-separated key ring, newest first:
#   v2:<base64 32 bytes>,v1:<base64 32 bytes>
# Generate a key with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ---------------------------------------------------------------------------------------
FIELD_ENCRYPTION_KEYS=

# ---------------------------------------------------------------------------------------
# Monitoring and analytics (EU regions). PostHog loads only after cookie consent.
# ---------------------------------------------------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
