{
  "note": "One set of cases for both runners (M2-13). Vitest runs them against slotProblem in packages/core/src/slots.ts; pgTAP runs them against private.slot_problem, through the generated supabase/tests/31_availability_vectors_test.sql. Edit this file, then run pnpm db:vectors.",
  "timeZone": "Europe/London",
  "defaults": {
    "hours": [
      { "weekday": 2, "start": "09:00", "end": "17:00" },
      { "weekday": 7, "start": "09:00", "end": "13:00" }
    ],
    "rules": { "durationMinutes": 60, "bufferMinutes": 30, "noticeHours": 24, "horizonWeeks": 8, "stepMinutes": 30 },
    "now": "2026-09-10T09:00:00Z",
    "by": "learner"
  },
  "vectors": [
    {
      "name": "a lesson inside the working day can be booked",
      "startsAt": "2026-09-15T09:00:00Z",
      "expect": null
    },
    {
      "name": "the last lesson that fits before the day ends can be booked",
      "startsAt": "2026-09-15T15:00:00Z",
      "expect": null
    },
    {
      "name": "a lesson that would run past the end of the day is outside availability",
      "startsAt": "2026-09-15T16:00:00Z",
      "expect": "OUTSIDE_AVAILABILITY"
    },
    {
      "name": "a lesson before the day starts is outside availability",
      "startsAt": "2026-09-15T07:00:00Z",
      "expect": "OUTSIDE_AVAILABILITY"
    },
    {
      "name": "a day the instructor does not work is outside availability",
      "startsAt": "2026-09-16T10:00:00Z",
      "expect": "OUTSIDE_AVAILABILITY"
    },
    {
      "name": "a lesson inside a day that has been blocked out is outside availability",
      "exceptions": [
        { "kind": "blocked", "startsAt": "2026-09-15T00:00:00Z", "endsAt": "2026-09-16T00:00:00Z" }
      ],
      "startsAt": "2026-09-15T09:00:00Z",
      "expect": "OUTSIDE_AVAILABILITY"
    },
    {
      "name": "a lesson beside an afternoon off can still be booked",
      "exceptions": [
        { "kind": "blocked", "startsAt": "2026-09-15T12:00:00Z", "endsAt": "2026-09-15T16:00:00Z" }
      ],
      "startsAt": "2026-09-15T09:00:00Z",
      "expect": null
    },
    {
      "name": "a lesson that runs into an afternoon off is outside availability",
      "exceptions": [
        { "kind": "blocked", "startsAt": "2026-09-15T12:00:00Z", "endsAt": "2026-09-15T16:00:00Z" }
      ],
      "startsAt": "2026-09-15T11:30:00Z",
      "expect": "OUTSIDE_AVAILABILITY"
    },
    {
      "name": "extra hours on a day off can be booked",
      "exceptions": [
        { "kind": "open", "startsAt": "2026-09-16T17:00:00Z", "endsAt": "2026-09-16T20:00:00Z" }
      ],
      "startsAt": "2026-09-16T17:00:00Z",
      "expect": null
    },
    {
      "name": "a lesson that clashes with one already booked is taken",
      "busy": [{ "startsAt": "2026-09-15T09:30:00Z", "endsAt": "2026-09-15T10:30:00Z" }],
      "startsAt": "2026-09-15T09:00:00Z",
      "expect": "SLOT_TAKEN"
    },
    {
      "name": "a lesson that would leave no travel time before the next one is taken",
      "busy": [{ "startsAt": "2026-09-15T11:00:00Z", "endsAt": "2026-09-15T12:00:00Z" }],
      "startsAt": "2026-09-15T09:40:00Z",
      "expect": "SLOT_TAKEN"
    },
    {
      "name": "a lesson that finishes its travel time exactly as the next begins can be booked",
      "busy": [{ "startsAt": "2026-09-15T11:00:00Z", "endsAt": "2026-09-15T12:00:00Z" }],
      "startsAt": "2026-09-15T09:30:00Z",
      "expect": null
    },
    {
      "name": "a lesson too soon for the notice the Business asks for is refused",
      "now": "2026-09-15T08:00:00Z",
      "startsAt": "2026-09-15T09:00:00Z",
      "expect": "NOTICE_TOO_SHORT"
    },
    {
      "name": "the same lesson booked by the instructor is fine",
      "now": "2026-09-15T08:00:00Z",
      "by": "instructor",
      "startsAt": "2026-09-15T09:00:00Z",
      "expect": null
    },
    {
      "name": "an instructor may book outside their own availability",
      "by": "instructor",
      "startsAt": "2026-09-15T19:00:00Z",
      "expect": null
    },
    {
      "name": "an instructor may not book on top of a lesson they already have",
      "by": "instructor",
      "busy": [{ "startsAt": "2026-09-15T09:30:00Z", "endsAt": "2026-09-15T10:30:00Z" }],
      "startsAt": "2026-09-15T09:00:00Z",
      "expect": "SLOT_TAKEN"
    },
    {
      "name": "a lesson further ahead than the diary is open is refused",
      "startsAt": "2026-12-15T09:00:00Z",
      "expect": "BEYOND_HORIZON"
    },
    {
      "name": "the morning the clocks go forward, the hour that does not happen cannot be booked",
      "hours": [{ "weekday": 7, "start": "00:00", "end": "06:00" }],
      "now": "2026-03-20T09:00:00Z",
      "startsAt": "2026-03-29T01:00:00Z",
      "expect": null
    },
    {
      "name": "the morning the clocks go back, the repeated hour is one o clock the first time",
      "hours": [{ "weekday": 7, "start": "00:00", "end": "06:00" }],
      "now": "2026-10-16T09:00:00Z",
      "startsAt": "2026-10-25T00:30:00Z",
      "expect": null
    },
    {
      "name": "a lesson on the clock change Sunday outside the hours worked is still refused",
      "hours": [{ "weekday": 7, "start": "00:00", "end": "06:00" }],
      "now": "2026-10-16T09:00:00Z",
      "startsAt": "2026-10-25T07:00:00Z",
      "expect": "OUTSIDE_AVAILABILITY"
    }
  ]
}
